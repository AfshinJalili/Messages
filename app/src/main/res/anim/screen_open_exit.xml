<?xml version="1.0" encoding="utf-8"?>
<!-- Opening: the old screen grows slightly behind the new one. Values in values/motion.xml. -->
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/motion_open_ms"
    android:fromXScale="1"
    android:fromYScale="1"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toXScale="@dimen/motion_zoom_large"
    android:toYScale="@dimen/motion_zoom_large"
    android:zAdjustment="bottom" />
