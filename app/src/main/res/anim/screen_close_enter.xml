<?xml version="1.0" encoding="utf-8"?>
<!-- Back: the screen underneath settles from slightly large. Values in values/motion.xml. -->
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/motion_close_ms"
    android:fromXScale="@dimen/motion_zoom_large"
    android:fromYScale="@dimen/motion_zoom_large"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toXScale="1"
    android:toYScale="1"
    android:zAdjustment="bottom" />
