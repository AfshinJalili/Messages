<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen and tab motion, the single source of truth. Activity animations in res/anim and
    Compose stacks in ui/components/Motion.kt both read these values. No alpha crossfade:
    screens slide from the end with a small parallax on the screen underneath; tabs use a
    short opaque cover slide (incoming only). Easing is emphasized decelerate (res/interpolator).
-->
<resources>
    <integer name="motion_open_ms">220</integer>
    <integer name="motion_close_ms">220</integer>
    <integer name="motion_tab_ms">120</integer>
    <!-- Underneath screen shifts this fraction of its width toward the start when covered. -->
    <item name="motion_parallax" type="dimen" format="float">0.25</item>
    <!-- Incoming tab starts this fraction of its width off-screen, then covers the outgoing tab. -->
    <item name="motion_tab_shift" type="dimen" format="float">0.30</item>
</resources>
