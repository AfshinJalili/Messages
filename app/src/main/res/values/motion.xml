<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen motion, the single source of truth (#176). One zoom for every screen change: the activity
    animations in res/anim and the Compose stacks in ui/components/Motion.kt both read these values.
    Opening: the new screen grows in from motion_zoom_small and fades in, over the old one growing
    to motion_zoom_large. Back reverses it: the top screen shrinks to motion_zoom_small and fades out.
-->
<resources>
    <integer name="motion_open_ms">300</integer>
    <integer name="motion_close_ms">250</integer>
    <item name="motion_zoom_small" type="dimen" format="float">0.92</item>
    <item name="motion_zoom_large" type="dimen" format="float">1.05</item>
</resources>
