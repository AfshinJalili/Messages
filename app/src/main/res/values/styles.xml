<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="AppTheme.OpenLine.Dark" />

    <style name="AppTheme.OpenLine.Dark" parent="AppTheme.Base">
        <item name="colorPrimary">@color/open_line_primary_dark</item>
        <item name="colorOnPrimary">@color/design_ink</item>
        <item name="colorPrimaryDark">@color/open_line_primary_dark</item>
        <item name="colorAccent">@color/open_line_primary_dark</item>
        <item name="colorSecondary">@color/open_line_primary_dark</item>
        <item name="colorOnSecondary">@color/design_ink</item>
        <item name="colorPrimaryContainer">@color/brand_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container_dark</item>
        <item name="colorSecondaryContainer">@color/brand_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_container_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:colorControlActivated">@color/open_line_primary_dark</item>
        <item name="colorControlActivated">@color/open_line_primary_dark</item>
        <item name="materialAlertDialogTheme">@style/OpenLine.Dialog</item>
    </style>

    <style name="AppTheme.OpenLine.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/open_line_pine</item>
        <item name="colorOnPrimary">@color/on_action</item>
        <item name="colorPrimaryDark">@color/open_line_pine</item>
        <item name="colorAccent">@color/open_line_pine</item>
        <item name="colorSecondary">@color/open_line_pine</item>
        <item name="colorOnSecondary">@color/on_action</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_container</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="android:colorControlActivated">@color/open_line_pine</item>
        <item name="colorControlActivated">@color/open_line_pine</item>
        <item name="materialAlertDialogTheme">@style/OpenLine.Dialog</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="roundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/normal_margin</item>
    </style>
    <!-- Google Messages details pills: icon over a short verb, four across -->
    <style name="ConversationActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">@dimen/small_margin</item>
        <item name="android:minHeight">@dimen/conversation_action_min_height</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">@dimen/small_margin</item>
    </style>
    <style name="InboxComposeShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="OpenLine.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/OpenLine.DialogShape</item>
    </style>
    <style name="OpenLine.DialogShape" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="OpenLine.SettingsLabel" parent="SettingsTextLabelStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/open_line_body_font</item>
        <item name="android:minHeight">@dimen/touch_target_size</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
    </style>
    <style name="OpenLine.SettingsValue" parent="SettingsTextValueStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/open_line_body_font</item>
        <item name="android:alpha">@dimen/opacity_opaque</item>
    </style>
    <style name="OpenLine.SettingsSwitch" parent="SettingsSwitchStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/open_line_body_font</item>
        <item name="android:minHeight">@dimen/touch_target_size</item>
    </style>
</resources>
