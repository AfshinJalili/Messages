<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thread_spam_group_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="@dimen/touch_target_size"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/activity_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/thread_spam_group_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/smaller_text_size" />

    <ImageView
        android:id="@+id/thread_spam_group_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/small_margin"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_expand_down" />

</LinearLayout>
