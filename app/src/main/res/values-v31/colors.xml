<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Fossify treats "system theme" as Material You wallpaper colors on API 31+.
      Override every you_* role to the static GM3 light baseline so wallpaper never recolors the app.
      Dark night values are in values-night-v31/.
    -->
    <color name="you_status_bar_color">@color/m3_surface</color>
    <color name="you_contextual_status_bar_color">@color/m3_primary</color>
    <color name="you_background_color">@color/m3_background</color>
    <color name="you_bottom_bar_color">@color/m3_surface_container</color>
    <color name="you_neutral_text_color">@color/m3_on_surface</color>
    <color name="you_primary_color">@color/m3_primary</color>
    <color name="you_primary_dark_color">@color/m3_primary</color>
    <color name="you_dialog_background_color">@color/m3_surface_container_high</color>
    <color name="you_surface_color">@color/m3_surface_container</color>
    <color name="you_selected_item_background_color">@color/m3_secondary_container</color>
    <color name="you_ripple_color">@color/m3_surface_container_highest</color>
</resources>
