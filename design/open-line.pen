                  "type": "text",
                  "id": "JGItZ",
                  "name": "Touch & reading requirements",
                  "fill": "$on-surface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "48 × 48 dp minimum touch targets; 8 dp between adjacent controls. Message text 18 sp, supporting text 14–16 sp. Use sp and system font scaling. Long names and content wrap; timelines scroll at runtime. Canvas screens show the full content rather than simulating scrolling.",
                  "lineHeight": "$leading-body",
                  "fontFamily": "$fontBody",
                  "fontSize": "$text-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "JIzDE",
              "name": "Persian & bidi",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "uTaAS",
                  "name": "Persian & bidi heading",
                  "fill": "$on-surface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Persian & bidi",
                  "fontFamily": "$fontDisplay",
                  "fontSize": "$text-title-lg",
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "Hi3PM",
                  "name": "Persian & bidi requirements",
                  "fill": "$on-surface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Vazirmatn for Persian, body leading 1.7. Mirror navigation order, back/disclosure arrows, attachment and send placement. Do not mirror phone, search, camera, clock, media controls or number strings. Isolate +98 numbers, URLs, OTPs and Latin names. Preserve copied data. Offer Persian/Gregorian calendar choice; sample date: ۲ مهر ۱۴۰۵.",
                  "lineHeight": "$leading-body",
                  "fontFamily": "$fontBody",
                  "fontSize": "$text-body",
                  "fontWeight": "normal"
                }
              ]
            },
