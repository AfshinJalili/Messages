                },
                {
                  "type": "text",
                  "id": "RN3Ik",
                  "name": "Implementation acceptance gates requirements",
                  "fill": "$on-surface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Not established by these mockups: TalkBack names, roles, reading order and status announcements; keyboard and switch access; 200% font scale; keyboard-open layout; Android system Back. Test Persian/Arabic digit entry and paste, ی/ي and ک/ك search matching, نیم‌فاصله and mixed-direction selection. Confirm destructive actions and preserve drafts on failure.",
                  "lineHeight": "$leading-body",
                  "fontFamily": "$fontBody",
                  "fontSize": "$text-body",
                  "fontWeight": "normal"
                }
              ]
            }
