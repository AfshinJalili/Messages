                {
                  "type": "text",
                  "id": "Hi3PM",
                  "name": "Persian & bidi requirements",
                  "fill": "$on-surface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Vazirmatn for Persian, body leading 1.7. Mirror navigation order, back/disclosure arrows, attachment and send placement. Do not mirror phone, search, camera, clock, media controls or number strings. Isolate +98 numbers, URLs, OTPs and Latin names. Preserve copied data. Offer Persian/Gregorian calendar choice; sample date: ۲ مهر ۱۴۰۵.",
                  "lineHeight": "$leading-body",
                  "fontFamily": "$fontBody",
                  "fontSize": "$text-body",
                  "fontWeight": "normal"
                }
              ]
            },
